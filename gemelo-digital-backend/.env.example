BRIGHTSPACE_CLIENT_ID=your_client_id
BRIGHTSPACE_CLIENT_SECRET=your_client_secret
BRIGHTSPACE_REDIRECT_URI=https://your-domain/auth/brightspace/callback
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ── Correo (SMTP) — Office365 ─────────────────────────────────────────────
# Usado para reportes de error y anuncios del administrador.
# Requiere un buzón de Office365 con SMTP AUTH habilitado. Si la cuenta usa
# MFA, genera una "contraseña de aplicación" y úsala en SMTP_PASSWORD.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=cuenta@cesa.edu.co
SMTP_PASSWORD=app_password_o_password
SMTP_FROM=cuenta@cesa.edu.co
SMTP_FROM_NAME=G.D CESA
# SMTP_USE_SSL=1   # solo si usas puerto 465 (SSL directo) en vez de 587 STARTTLS

# Correo del administrador que recibe los reportes de error (bug reports).
BUG_REPORT_EMAIL=desarrolloprofesoral@cesa.edu.co
# IDs de super-administrador (coincide con VITE_SUPERADMIN_IDS del frontend).
SUPERADMIN_IDS=5427